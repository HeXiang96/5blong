{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.cache/tsconfig.tools.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // 测试与工具脚本里有 .mjs，需要 allowJs。
    "allowJs": true,
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals", "vite/client"],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  // 只包含本项目实际存在的配置与测试。
  "include": ["../vite.config.ts", "../vitest.config.ts", "../tests"]
}
