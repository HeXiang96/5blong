[Unit]
Description=5blong web bundle sync (GitHub Release -> /var/www/5blong, keeps desktop/)
Documentation=file:/opt/5blong/server/scripts/sync-web.mjs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/node /opt/5blong/server/scripts/sync-web.mjs
Nice=10
# 只读远端、只写静态站目录，不需要任何密钥
